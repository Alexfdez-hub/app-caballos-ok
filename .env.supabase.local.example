# Copy to .env.supabase.local. Replace the key with the local anon key.
# Do not commit the copy. Do not put a service_role key here.
# 127.0.0.1 reaches Supabase only on this computer. A phone needs the
# computer's LAN address, or a separate tunnel to port 54321, in this URL.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-or-publishable-key
