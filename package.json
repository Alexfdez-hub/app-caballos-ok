{
  "name": "app-caballos-ok",
  "description": "Aplicación Expo para la plataforma de alquiler ecuestre.",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "npm run start:local",
    "start:local": "node scripts/start-expo.cjs local",
    "start:remote": "node scripts/start-expo.cjs remote",
    "android": "npm run android:local",
    "android:local": "npm run start:local -- --android",
    "android:remote": "npm run start:remote -- --android",
    "ios": "npm run ios:local",
    "ios:local": "npm run start:local -- --ios",
    "ios:remote": "npm run start:remote -- --ios",
    "web": "npm run web:local",
    "web:local": "npm run start:local -- --web",
    "web:remote": "npm run start:remote -- --web",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:auth && npm run test:sql",
    "test:sql": "npm run test:identity && npm run test:guardians && npm run test:riders && npm run test:centers && npm run test:memberships && npm run test:equines && npm run test:ownership && npm run test:center-relations && npm run test:disciplines && npm run test:qualifications && npm run test:assessments && npm run test:equine-requirements && npm run test:center-services && npm run test:zero-sessions && npm run test:calendar && npm run test:bookings && npm run test:booking-functions && npm run test:sessions && npm run test:activity && npm run test:reviews-incidents && npm run test:audit && npm run test:storage && npm run test:zero-session-approval",
    "test:sessions": "node scripts/run-sessions-sql-tests.cjs && node scripts/run-sessions-concurrency-test.cjs",
    "test:activity": "node scripts/run-activity-sql-tests.cjs && node scripts/run-activity-concurrency-test.cjs",
    "test:reviews-incidents": "node scripts/run-reviews-incidents-sql-tests.cjs && node scripts/run-reviews-incidents-concurrency-test.cjs",
    "test:audit": "node scripts/run-audit-sql-tests.cjs && node scripts/run-audit-concurrency-test.cjs",
    "test:storage": "node scripts/run-storage-sql-tests.cjs",
    "test:zero-session-approval": "node scripts/run-zero-session-approval-sql-tests.cjs && node scripts/run-zero-session-approval-concurrency-test.cjs",
    "test:zero-sessions": "node scripts/run-zero-sessions-sql-tests.cjs",
    "test:calendar": "node scripts/run-calendar-sql-tests.cjs",
    "test:bookings": "node scripts/run-bookings-sql-tests.cjs",
    "test:booking-functions": "node scripts/run-booking-functions-sql-tests.cjs && node scripts/run-booking-functions-concurrency-test.cjs",
    "test:auth": "node --experimental-strip-types --test src/features/auth/*.test.ts src/features/identity/*.test.ts src/features/guardians/*.test.ts src/features/riders/*.test.ts src/features/centers/*.test.ts src/features/equines/*.test.ts",
    "test:equines": "node scripts/run-equines-sql-tests.cjs",
    "test:ownership": "node scripts/run-ownership-sql-tests.cjs",
    "test:center-relations": "node scripts/run-center-relations-sql-tests.cjs",
    "test:disciplines": "node scripts/run-disciplines-sql-tests.cjs",
    "test:qualifications": "node scripts/run-qualifications-sql-tests.cjs",
    "test:assessments": "node scripts/run-assessments-sql-tests.cjs",
    "test:equine-requirements": "node scripts/run-equine-requirements-sql-tests.cjs",
    "test:center-services": "node scripts/run-center-services-sql-tests.cjs",
    "test:memberships": "node scripts/run-memberships-sql-tests.cjs",
    "test:identity": "node scripts/run-identity-sql-tests.cjs",
    "test:guardians": "node scripts/run-guardians-sql-tests.cjs && node scripts/run-guardians-concurrency-test.cjs",
    "test:riders": "node scripts/run-riders-sql-tests.cjs",
    "test:centers": "node scripts/run-centers-sql-tests.cjs",
    "check:env": "node scripts/check-env-gitignore.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@supabase/supabase-js": "^2.112.4",
    "expo": "~54.0.0",
    "expo-auth-session": "~7.0.11",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
