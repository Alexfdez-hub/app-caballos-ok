# Copy the matching example to a gitignored file and fill in real keys locally.
# Do not commit real credentials.
#
# Local Supabase (default): copy .env.supabase.local.example
#   to .env.supabase.local, then: npm run start:local
#
# Remote Supabase / physical Android: copy .env.supabase.remote.example
#   to .env.supabase.remote, then: npm run start:remote
#
# Those scripts copy the chosen file to gitignored .env.local so Expo
# inlines EXPO_PUBLIC_* into the native and web bundles.
#
# Use only the anon or publishable key. Never put service_role or secret keys here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
